PROJECT_NAME=Nova-AI
VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=nova_ai
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/nova_ai
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./data/nova_ai.db

# CORS settings (comma-separated list of allowed frontend origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local AI / Ollama Configuration
AI_DEFAULT_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
